PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/gradle?sslmode=disable
JWT_SECRET=
JWT_EXPIRY_HOURS=24
REDIS_URL=redis://localhost:6379/0
INTERNAL_API_TOKEN=
CORS_ORIGINS=http://localhost:5173

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gradle-artifacts
S3_REGION=us-east-1
S3_VIRTUAL_HOST_STYLE=false

# Google Classroom integration — client ID/secret come from a Web OAuth
# client in Google Cloud Console (APIs & Services > Credentials); redirect
# URL must exactly match one registered on that client and point at this
# backend's own callback route, not the dashboard or mobile app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/integrations/google/callback
# Any random secret string (e.g. `openssl rand -base64 32`) — not from
# Google — used to encrypt stored refresh tokens at rest.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Where /callback sends a teacher back to after connecting (dashboard origin).
DASHBOARD_URL=http://localhost:5173
